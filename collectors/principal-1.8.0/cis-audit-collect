__cis_run journald.servicio 120 'for __u in systemd-journald.service; do echo "$__u|$(systemctl is-enabled "$__u" 2>&1)|$(systemctl is-active "$__u" 2>&1)"; done'
__cis_run journald.remoto 120 'for u in systemd-journal-upload.service systemd-journal-remote.socket systemd-journal-remote.service; do echo "$u|$(systemctl is-enabled "$u" 2>&1)|$(systemctl is-active "$u" 2>&1)"; done'
__cis_run aide.timer 120 'for __u in aidecheck.service aidecheck.timer; do echo "$__u|$(systemctl is-enabled "$__u" 2>&1)|$(systemctl is-active "$__u" 2>&1)"; done'
if [ "$__fam" = sles ]; then __cis_run coredump.servicio 120 'for __u in systemd-coredump.socket coredump.service; do echo "$__u|$(systemctl is-enabled "$__u" 2>&1)|$(systemctl is-active "$__u" 2>&1)"; done'; fi
__cis_run p1.unidades 120 'for __u in autofs.service avahi-daemon.socket avahi-daemon.service dhcpd.service dhcpd6.service named.service dnsmasq.service vsftpd.service dovecot.socket dovecot.service cyrus-imapd.service nfs-server.service ypserv.service cups.socket cups.service rpcbind.socket rpcbind.service rsyncd.socket rsyncd.service smb.service snmpd.service telnet.socket tftp.socket tftp.service squid.service httpd.socket httpd.service nginx.service apache2.service xinetd.service slapd.service crond.service cron.service chronyd.service chrony.service systemd-timesyncd.service tmp.mount; do echo "$__u|$(systemctl is-enabled "$__u" 2>&1)|$(systemctl is-active "$__u" 2>&1)"; done'
__cis_run p1.chrony 120 'for f in /etc/chrony.conf /etc/chrony.d/*.conf /etc/chrony/chrony.conf; do [ -e "$f" ] || continue; if [ ! -r "$f" ]; then echo "#NO_LEGIBLE|$f"; continue; fi; echo "F|$f"; grep -nE '"'"'^[[:space:]]*(server|pool|sourcedir|confdir|include)[[:space:]]'"'"' -- "$f" | grep -vE '"'"'^[0-9]+:[[:space:]]*#'"'"' | while IFS= read -r l; do printf '"'"'T|%s|%s\n'"'"' "$f" "$l"; done; done'
echo "@@CIS_FIN"
} 2>&1 | __redactar
__st=("${PIPESTATUS[@]}")
if [ "${__st[1]}" -ne 0 ]; then printf '\n@@CIS_FATAL|redaccion_fallida|rc=%s\n' "${__st[1]}"; exit 3; fi
if [ "${__st[0]}" -ne 0 ]; then printf '\n@@CIS_FATAL|recoleccion_interrumpida|rc=%s\n' "${__st[0]}"; exit 3; fi
exit 0
